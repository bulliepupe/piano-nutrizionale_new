// Regole di sicurezza Firestore per "Il mio Piano".
//
// Come applicarle: Firebase Console → Firestore Database → scheda "Regole"
// → incolla questo intero file al posto di quello presente → "Pubblica".
//
// Logica generale:
// - ogni utente ha un documento /users/{uid} con "ruolo": "professionista"
//   oppure "paziente";
// - il professionista ha una LICENZA (campo users/{uid}.licenza) che decide
//   se può creare pazienti e modificare i piani. La licenza la scrive SOLO il
//   server (Cloud Functions collegate ai pagamenti Stripe): dall'app si può
//   solo creare, al momento della registrazione, la prova gratuita di 30
//   giorni con 3 pazienti — nient'altro;
// - un piano (/piani/{id}) si legge dal paziente a cui è assegnato e dal
//   professionista proprietario; si modifica solo dal professionista, e solo
//   con licenza attiva. Il paziente continua a leggere il suo piano anche se
//   la licenza del professionista scade;
// - le spunte "pasto fatto" e la lista della spesa vivono sotto l'utente
//   paziente e le scrive lui; il suo professionista può solo LEGGERE le
//   spunte, per le statistiche di andamento.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function utente() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isProfessionista() {
      return isSignedIn() && utente().ruolo == "professionista";
    }

    // Licenza valida: stato "attiva" e non scaduta.
    function licenzaAttiva() {
      let l = utente().get("licenza", null);
      return l != null && l.stato == "attiva" && (l.scadenza == null || l.scadenza > request.time);
    }

    // Prova gratuita creata dall'app alla registrazione: solo questi valori.
    function provaValida(l) {
      return l.keys().hasOnly(["piano", "maxPazienti", "stato", "scadenza"])
        && l.piano == "prova" && l.maxPazienti == 3 && l.stato == "attiva"
        && l.scadenza is timestamp
        && l.scadenza <= request.time + duration.value(31, "d");
    }

    match /users/{userId} {
      // Ognuno legge il proprio documento; il professionista legge anche
      // quelli dei SUOI pazienti (non quelli di altri professionisti).
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource.data.get("professionistaUid", "") == request.auth.uid)
      );

      allow create: if isSignedIn() && request.auth.uid == userId && (
        (request.resource.data.ruolo == "professionista" && provaValida(request.resource.data.licenza)) ||
        (request.resource.data.ruolo == "paziente" && !("licenza" in request.resource.data))
      );

      // Aggiornare i propri dati sì, ma mai ruolo e licenza.
      allow update: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ruolo", "licenza", "professionistaUid"]);
      allow delete: if false;

      // Spunte "pasto fatto": le scrive solo il paziente. Il SUO professionista
      // può leggerle (non modificarle) per le statistiche di andamento.
      match /pastiFatti/{giorno} {
        allow write: if isSignedIn() && request.auth.uid == userId;
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(userId)).data.get("professionistaUid", "") == request.auth.uid
        );
      }

      // Lista della spesa del paziente: una lista per settimana + le sue
      // correzioni (nome, categoria, articoli nascosti). Solo lui la vede.
      match /spesa/{documento} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /piani/{pianoId} {
      allow read: if isSignedIn() &&
        (resource.data.pazienteUid == request.auth.uid || resource.data.professionistaUid == request.auth.uid);

      allow create: if isProfessionista() && licenzaAttiva()
        && request.resource.data.professionistaUid == request.auth.uid;
      allow update: if isProfessionista() && licenzaAttiva()
        && resource.data.professionistaUid == request.auth.uid
        && request.resource.data.professionistaUid == request.auth.uid;
      // Eliminare un paziente è sempre possibile (anche a licenza scaduta).
      allow delete: if isProfessionista() && resource.data.professionistaUid == request.auth.uid;
    }

    // Ricette del professionista. Le legge lui e i SUOI pazienti: tutti, se
    // la ricetta è "per tutti", altrimenti solo quelli scelti (destinatari).
    // Si pubblicano e si modificano solo con licenza attiva; eliminarle è
    // sempre possibile.
    match /ricette/{ricettaId} {
      allow read: if isSignedIn() && (
        resource.data.professionistaUid == request.auth.uid ||
        (resource.data.professionistaUid == utente().get("professionistaUid", "") &&
          (resource.data.visibilita == "tutti" || request.auth.uid in resource.data.destinatari))
      );
      allow create: if isProfessionista() && licenzaAttiva()
        && request.resource.data.professionistaUid == request.auth.uid
        && request.resource.data.destinatari is list;
      allow update: if isProfessionista() && licenzaAttiva()
        && resource.data.professionistaUid == request.auth.uid
        && request.resource.data.professionistaUid == request.auth.uid
        && request.resource.data.destinatari is list;
      allow delete: if isProfessionista() && resource.data.professionistaUid == request.auth.uid;
    }

    // Tutto il resto (licenze in attesa, registro notifiche) è solo per il server.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
